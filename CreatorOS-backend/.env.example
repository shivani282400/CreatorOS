# ───────────── Server ─────────────
PORT=4000
NODE_ENV=development
# Set to true when running behind a proxy/load balancer (Render, Vercel rewrites) so rate limits see real client IPs
TRUST_PROXY=false

# ───────────── Database (Postgres + pgvector, e.g. Supabase) ─────────────
# Supabase tip: on Render use the "Session pooler" or "Transaction pooler" string, not the direct host (IPv6 only).
DATABASE_URL=postgresql://user:password@localhost:5432/creatoros
# Optional: force SSL on/off. By default SSL is used for hosted databases and in production.
# DATABASE_SSL=true
# DB_POOL_MAX=10

# ───────────── Auth (required) ─────────────
# The server REFUSES TO START without JWT_SECRET. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
OTP_HMAC_SECRET=replace_with_a_separate_long_random_secret
# Access token lifetime (default 15m). Use e.g. 12h for portfolio demos if Safari blocks the refresh cookie.
# ACCESS_TOKEN_TTL=15m
# Set to false to close public sign-ups
# ALLOW_REGISTRATION=true

# ───────────── Browser access (CORS + cookies) ─────────────
# Comma-separated list of allowed frontend origins (no trailing slash). Required in production.
FRONTEND_URL=http://localhost:5173
# Refresh-cookie SameSite. Default: "none" in production, "lax" otherwise.
# Use "lax" when the frontend reaches the API through the Vercel /api rewrite (same-site).
# COOKIE_SAMESITE=lax

# ───────────── AI providers ─────────────
# Generation: Groq first, OpenRouter as automatic fallback. At least one is required.
GROQ_API_KEY=your_groq_key
# GROQ_MODEL=openai/gpt-oss-120b      # llama-3.3-70b-versatile was shut down by Groq on 2026-08-16
# GROQ_REASONING_EFFORT=low           # low | medium | high (gpt-oss models only)
OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Embeddings for RAG memory: OPENAI_API_KEY is used first, OPENROUTER_API_KEY otherwise. Without either, generation still works but without memory.
OPENAI_API_KEY=your_openai_key
# AI_TIMEOUT_MS=60000
# AI_RATE_LIMIT_MAX=20        # generations per user-IP per 10 minutes

# ───────────── Email sign-in codes (OTP), OPTIONAL ─────────────
# Leave every email setting empty to run password-only: the login page hides the email-code option automatically.
# Provider is auto-detected (Brevo > Resend > SMTP). Force one with EMAIL_PROVIDER=smtp|brevo|resend.
# OTP_ENABLED=false           # hard off-switch even if a provider is configured
# OTP_DAILY_LIMIT=90          # global cap per 24h so a free email quota is never exhausted

# Option 1: SMTP / Gmail (local development: Render's free tier blocks SMTP ports)
# Google Account → Security → 2-Step Verification → App passwords
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Option 2: Brevo (HTTPS API, works on Render free tier; verify one sender address)
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER_EMAIL=you@example.com
# BREVO_SENDER_NAME=CreatorOS

# Option 3: Resend (needs a verified domain to email anyone but yourself)
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=CreatorOS <auth@your-verified-domain.example>

# ───────────── Demo account for recruiters, OPTIONAL ─────────────
# Creates this account on startup and fills it with sample content the first time.
# DEMO_EMAIL=demo@creatoros.app
# DEMO_PASSWORD=Demo@12345
# DEMO_SHOW_ON_LOGIN=true     # shows a "Try the demo account" button (credentials become public)
# DEMO_SEED_CONTENT=true
